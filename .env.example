# LicitaQui — environment variable NAMES only. Never commit values.
# Values live in Vercel, Easypanel and GitHub Actions secrets.

# Database — Neon via Vercel (spec §5.1)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth (spec §5)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email
RESEND_API_KEY=

# AI
OPENROUTER_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp — Evolution API
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Payments — Asaas (sandbox|production)
ASAAS_ENV=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Worker
WORKER_URL=
WORKER_WAKE_TOKEN=

# Storage
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Observability
SENTRY_DSN_WEB=
SENTRY_DSN_WORKER=

# ── Database tuning (optional; F1) ──────────────────────────────────────────────
# Defaults match the spec §7.2 budget and need no value in production.
# Raise them only where lock-wait time is legitimately long, e.g. the concurrency
# test that queues 60 signups behind one advisory lock over a remote connection.
DATABASE_POOL_MAX=
DATABASE_CONNECT_TIMEOUT_MS=
DATABASE_QUERY_TIMEOUT_MS=

# ── Worker runtime (optional; B1) ───────────────────────────────────────────────
# Defaults come from spec §7.2 and §5.1 and need no value in production.
# WORKER_POLL_INTERVAL_SECONDS defaults to 120: a hotter loop keeps Neon's
# compute awake and burns the Free plan's 100 CU-hours.
WORKER_PORT=
WORKER_CONCURRENCY=
WORKER_POLL_INTERVAL_SECONDS=
WORKER_SCHEDULER=
# Restrict a container to part of the queue (comma-separated job kinds).
WORKER_JOB_KINDS=
